NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://driver_feedback:driver_feedback@localhost:5432/driver_feedback
DATABASE_SSL_MODE=disable
# DigitalOcean Standard Edition maximum-security option:
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_CERT_PATH=/absolute/path/to/ca-certificate.crt
# Alternatively, use DATABASE_CA_CERT_BASE64 for hosted secret environments.
DATABASE_MAX_CONNECTIONS=10
SESSION_COOKIE_NAME=id
SESSION_TTL_HOURS=12
FRONTEND_ORIGINS=http://localhost:3001
