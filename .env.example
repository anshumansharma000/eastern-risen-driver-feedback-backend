NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://driver_feedback:driver_feedback@localhost:5432/driver_feedback
# Cashfree Payment Gateway. Keep these as server-side secrets.
CASHFREE_ENV=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Full public API URL ending in /api/v1/core/payments/webhooks/cashfree.
CASHFREE_WEBHOOK_URL=
# PostgreSQL-backed reconciliation; no Redis or additional service required.
PAYMENT_RECONCILIATION_WORKER_ENABLED=true
PAYMENT_RECONCILIATION_POLL_INTERVAL_MS=1000
PAYMENT_PENDING_REVIEW_AFTER_HOURS=24
PAYMENT_CLOSED_RECHECK_DAYS=7
DATABASE_SSL_MODE=disable
# DigitalOcean Standard Edition maximum-security option:
# DATABASE_SSL_MODE=verify-full
# DATABASE_CA_CERT_PATH=/absolute/path/to/ca-certificate.crt
# Alternatively, use DATABASE_CA_CERT_BASE64 for hosted secret environments.
DATABASE_MAX_CONNECTIONS=10
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_STATEMENT_TIMEOUT_MS=30000
SESSION_COOKIE_NAME=id
SESSION_IDLE_TTL_HOURS=72
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_ROTATION_INTERVAL_HOURS=24
SESSION_ROTATION_GRACE_SECONDS=60
FEEDBACK_HANDOFF_TTL_HOURS=168
# Public passenger form. The API appends the handoff token as the `token` query parameter.
PASSENGER_FEEDBACK_URL=http://localhost:3001/feedback
# Required in production. Generate 32 random bytes and store their base64 value as a secret.
DATA_ENCRYPTION_KEY_BASE64=
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:3001
TRUST_PROXY_HOPS=0
CONNECTION_TIMEOUT_MS=10000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=72000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576

# Private Cloudflare R2 storage for optional passenger feedback photos.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=easternrisen
R2_KEY_PREFIX=feedbackphotos
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Use the exact jurisdiction-specific endpoint from Cloudflare when applicable.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_UPLOAD_URL_TTL_SECONDS=600
R2_DOWNLOAD_URL_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=10485760
R2_ORPHAN_TTL_HOURS=24

# Customer website account base. Links append /activate or /reset-password.
# Leave provider and delivery credentials blank for manual invitations (recovery returns 503).
CUSTOMER_ACCOUNT_URL=
# Set to resend after filling the key, sender and account URL below.
CUSTOMER_MAIL_PROVIDER=
RESEND_API_KEY=
# Example: "Eastern Risen <accounts@notifications.yourdomain.com>" (verified sending domain).
CUSTOMER_MAIL_FROM=
# Optional monitored mailbox for replies.
CUSTOMER_MAIL_REPLY_TO=
# Automatic delivery runs in the existing API process; no separate worker is required.
CUSTOMER_MAIL_WORKER_ENABLED=true
CUSTOMER_MAIL_POLL_INTERVAL_MS=10000
# Alternative provider: relay. Retained for existing deployments.
CUSTOMER_MAIL_ENDPOINT=
CUSTOMER_MAIL_TOKEN=
