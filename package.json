{
  "name": "eastern-risen-driver-feedback-api",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for the Eastern Risen Driver Feedback Service",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:production": "node dist/scripts/migrate.js",
    "db:studio": "drizzle-kit studio",
    "admin:create": "tsx src/scripts/create-admin.ts",
    "session:cleanup": "tsx src/scripts/cleanup-sessions.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/sensible": "6.0.4",
    "@fastify/swagger": "9.8.1",
    "@fastify/type-provider-typebox": "6.1.0",
    "argon2": "0.45.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.10.0",
    "fastify-plugin": "5.1.0",
    "pg": "8.22.0",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fastify/swagger-ui": "6.1.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "drizzle-kit": "0.31.10",
    "eslint": "10.0.3",
    "pino-pretty": "13.1.3",
    "prettier": "^3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
